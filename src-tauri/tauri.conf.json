{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate Download Manager",
  "version": "0.1.0",
  "identifier": "com.ultimatedownloadmanager.app",
  "build": {
    "beforeDevCommand": "node tools/pack-extension.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node tools/pack-extension.mjs && cargo build --release -p udm-nmhost --target-dir target && powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/windows/sign.ps1 target/release/udm-nmhost.exe",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Ultimate Download Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#000000",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build-ext/extension-chromium/": "extension-chromium/",
      "../build-ext/extension-firefox/": "extension-firefox/",
      "../target/release/udm-nmhost.exe": "udm-nmhost.exe"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./windows/sign.ps1 %1",
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMEVGRUQyMUM0MzJBNTkKUldSWktrTWMwdjRPeW8vZ3ZtL25zaEd0ekorUjJrL051L2J2YUJ2UkNaWUxMNWl5ZVRCVENKY28K",
      "endpoints": [
        "https://github.com/D3MON999/Ultimate-Download-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "udm"
}
